# ─── Server ───
PORT=3000

# Public URL (optional, used for CORS/links)
# PUBLIC_URL=https://your-app.onrender.com

# ─── TURN Server (optional, for voice behind strict firewalls) ───
# Without TURN, voice uses STUN-only peer-to-peer. This works on most
# networks but will fail behind symmetric NAT / corporate firewalls.
# Get free TURN credentials from Metered (metered.ca) or Twilio.
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
